# Copy to .env.local (git-ignored) and adjust. Vite only exposes VITE_* vars to the browser.
#
# Which backend adapter to use:
#   mock      - in-browser sandbox, no network (default when Supabase vars are missing)
#   supabase  - the real JobObserver Supabase project (same one the desktop app uses)
VITE_BACKEND=mock

# Required when VITE_BACKEND=supabase. The anon key is public by design (RLS protects data);
# NEVER put the service-role key here - it would ship to every visitor's browser.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Mock backend only: let ANY e-mail/password sign in (demo deployments). Leave unset otherwise.
# Never meaningful for supabase. Build-time: it is inlined into the bundle.
# VITE_MOCK_ANY_CREDENTIALS=true

# Mock backend only: artificial latency in ms (0 disables). Useful to see loading states.
VITE_MOCK_LATENCY_MS=250
